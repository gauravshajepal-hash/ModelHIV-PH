               <rdf:li xml:lang="x-default">BMC Public Health, 2021, doi:10.1186/s12889-021-11498-x</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>Mortality</rdf:li>
               <rdf:li>Coronavirus</rdf:li>
               <rdf:li>Comorbidities</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">A risk index for COVID-19 severity is associated with COVID-19 mortality in New York City</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Wil Lieberman-Cribbin</rdf:li>
               <rdf:li>Naomi Alpert</rdf:li>
               <rdf:li>Raja Flores</rdf:li>
               <rdf:li>Emanuela Taioli</rdf:li>
            </rdf:Seq>
         </dc:creator>
      </rdf:Description>
